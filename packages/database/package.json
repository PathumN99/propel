{
  "name": "@propel/database",
  "version": "1.0.0",
  "description": "Database configuration and utilities for Propel",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm db:generate && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:migrate": "dotenv -e ../../.env -- prisma db push",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma db push",
    "db:reset": "dotenv -e ../../.env -- prisma db push --force-reset",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.18.0",
    "typescript": "^5.3.0"
  }
}
